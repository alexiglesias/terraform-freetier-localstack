# Copy to backend.tf (gitignored) after running the bootstrap, and fill in
# the bucket name it prints. Terraform needs the bucket to exist BEFORE
# `terraform init` can use it, which is why this isn't a real .tf file yet.
#
# Only the aws environment has a remote backend. envs/localstack keeps local
# state, in its own folder, so it can never touch this state file.

terraform {
  backend "s3" {
    bucket         = "CHANGE-ME-tfstate-bucket"
    key            = "terraform-freetier-localstack/aws/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "CHANGE-ME-tfstate-lock"
    encrypt        = true
  }
}
