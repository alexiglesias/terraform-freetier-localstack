# Copy to terraform.tfvars (gitignored) and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# No DB password anywhere: RDS generates it and stores it in Secrets Manager.

aws_region = "us-east-1"

# Shell access is through SSM Session Manager by default (no open port).
# Only if you really want SSH too, set your public IP as a /32:
#   curl -s https://checkip.amazonaws.com
# allowed_ssh_cidr = "203.0.113.10/32"

budget_alert_email = "you@example.com"

# create_alb         = true
# create_rds         = true
# enable_nat_gateway = false
