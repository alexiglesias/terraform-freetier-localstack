# Terraform
.terraform/
# NOTE: .terraform.lock.hcl is deliberately NOT ignored - commit it, so
# everyone (and CI, later) resolves the exact same provider versions.
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log

# Backend config generated from backend.tf.example - contains a real,
# account-specific bucket name, keep the template tracked, not the real one.
backend.tf

# Secrets and generated key material
*.pem
*.auto.tfvars
terraform.tfvars
.env

# OS / editor noise
.DS_Store
.vscode/

# Lock files belong to root configurations (envs/*), not reusable modules
modules/**/.terraform.lock.hcl
